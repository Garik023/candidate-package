# ===========================================
# Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Default port 5432, Docker dev port 5433
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=order_ops

# Redis (optional, for future caching/queuing)
# Default port 6379, Docker dev port 6380
REDIS_HOST=localhost
REDIS_PORT=6380

# Frontend (for serving static files in production)
FRONTEND_DIST_PATH=../frontend/dist

# Logging
LOG_LEVEL=debug
